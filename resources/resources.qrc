    <qresource prefix="/fonts">
        <!-- https://github.com/FortAwesome/Font-Awesome -->
        <file alias="fontawesome-solid">fonts/fontawesome-731/solid-900.otf</file>
        <file alias="fontawesome-brands">fonts/fontawesome-731/brands-400.otf</file>
